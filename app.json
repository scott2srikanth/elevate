{
  "expo": {
    "name": "Elevate",
    "slug": "elevate",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elevate.presencecoach"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.elevate.presencecoach",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a wardrobe photo to save in Elevate.",
          "cameraPermission": "Take a wardrobe photo with Elevate.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8D9C1",
          "image": "./assets/brand-splash.png",
          "imageWidth": 240
        }
      ],
      "expo-video"
    ],
    "scheme": "elevate"
  }
}
