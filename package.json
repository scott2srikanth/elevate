{
  "name": "elevate",
  "version": "1.3.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "node": "^22.23.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "wrangler": "^4.141.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "EXPO_PUBLIC_API_URL=http://localhost:8787 expo start --web",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "node --import tsx --test tests/coach.test.ts tests/development.test.ts tests/studio.test.ts tests/language.test.ts tests/content.test.ts tests/aiCoach.test.ts tests/observation.test.ts tests/observation-signals.test.mjs tests/offline.test.mjs tests/offline-worker.test.mjs tests/garment.test.ts tests/garment-engine.test.mjs",
    "test:e2e": "playwright test",
    "build:web": "node scripts/build-web.mjs",
    "build:android": "expo export --platform android --output-dir dist-android",
    "lint": "expo lint",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev:cloud": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "test:api": "node --import tsx --test tests/api.integration.ts",
    "check:deploy": "node scripts/check-deploy.mjs",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:aab": "npx eas-cli@latest build --platform android --profile production",
    "build": "npm run build:web",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "models:release": "node scripts/build-model-release.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23 || >=24.3.0"
  }
}
